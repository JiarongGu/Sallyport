<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows only (D9): what Sallyport needs of Windows itself — today the packet driver's management (D18). BCL only,
       like the library (rule 4): Windows is reached through P/Invoke. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PackageId>Sallyport.Windows</PackageId>
    <IsPackable>false</IsPackable>
    <!-- The driver is handed its packet buffers by address (ETH_M_REQUEST carries pointers), so they live in native
         memory and are reached through pointers; LibraryImport's stubs need it too. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sallyport.Windows.Tests" />
  </ItemGroup>

  <!-- A run's tunnel side (Service/RunPump.cs) is a TunnelSession consumer. -->
  <ItemGroup>
    <ProjectReference Include="..\Sallyport\Sallyport.csproj" />
  </ItemGroup>

</Project>

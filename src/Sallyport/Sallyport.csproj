<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Sallyport</RootNamespace>
    <Description>An app-scoped, OpenVPN-compatible client in pure .NET: the tunnel lives in the process and ends in a local SOCKS5 proxy. Written from the protocol, not OpenVPN's code. Not affiliated with OpenVPN Inc.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Sallyport</PackageId>
    <PackageTags>openvpn;vpn;tunnel;socks5;proxy;tcp-ip</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sallyport.Tests" />
    <!-- The probe measures below the public API (raw UDP through the tunnel for STUN): it may build packets as the library does. -->
    <InternalsVisibleTo Include="Sallyport.Probe" />
    <!-- So may the driver's console, injecting a reply of its own making to measure what reaches a socket. -->
    <InternalsVisibleTo Include="Sallyport.Driver" />
  </ItemGroup>

</Project>

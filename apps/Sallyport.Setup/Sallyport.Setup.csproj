<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sallyport's setup (docs/design/product.md §6): one administrator prompt, at its start, for everything it does.
       BCL only (rule 4). What it installs travels inside it as payload.zip, made by package.ps1; a build without one
       installs from a folder given on its command line (development). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\Sallyport.Client\Sallyport.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sallyport.Windows\Sallyport.Windows.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Payload)' != ''">
    <EmbeddedResource Include="$(Payload)" LogicalName="payload.zip" />
  </ItemGroup>

</Project>

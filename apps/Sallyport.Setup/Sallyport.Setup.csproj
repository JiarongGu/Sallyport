<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sallyport's setup (docs/design/product.md §6): one administrator prompt, at its start, for everything it does.
       BCL only (rule 4). Hosted by Sallyport's one program (D30): the release's file is that program, and what it
       installs is itself; a development build installs from a folder given on its command line. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sallyport.Windows\Sallyport.Windows.csproj" />
  </ItemGroup>

</Project>

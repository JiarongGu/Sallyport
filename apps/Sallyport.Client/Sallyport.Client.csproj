<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shenora by a decision (D9): rule 4 binds the packages, and an application may take one by a decision. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The name Task Manager and the file's properties give it. -->
    <AssemblyTitle>Sallyport</AssemblyTitle>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Drawn by icon.ps1 from the tray's mark: what Explorer, the Start menu and Windows' installed apps show. -->
    <ApplicationIcon>Sallyport.ico</ApplicationIcon>
    <!-- Shenora's packages and WinForms reference different builds of the same framework assemblies; the newer wins. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- Trimmed when published (the owner: "the setup.exe is really big?"): 53 MB whole, 29 trimmed. Partial: only the
       .NET assemblies that say they can be are cut (CoreLib 16 MB to 3.7, its JSON 1.9 to 0.5); ours, Shenora's,
       WebView2's and Windows Forms' are copied whole, byte for byte, so nothing our reflection reaches is cut.
       Windows Forms is refused trimming by default (NETSDK1175) for what trimming it would break; it is not trimmed.
       WebView2's wrapper is built-in COM interop, off by default when trimming. JSON by reflection, as every store
       here reads and writes its own records. -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- What the trim analysis says of reflection JSON in our own assemblies, which are not cut. -->
    <NoWarn>$(NoWarn);IL2026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sallyport\Sallyport.csproj" />
    <!-- Game routing: the router service's client and the packet driver's management. -->
    <ProjectReference Include="..\..\src\Sallyport.Windows\Sallyport.Windows.csproj" />
    <!-- Sallyport's one program (D30): the service and setup run in it, so the release carries one .NET runtime. -->
    <ProjectReference Include="..\Sallyport.Service\Sallyport.Service.csproj" />
    <ProjectReference Include="..\Sallyport.Setup\Sallyport.Setup.csproj" />
    <PackageReference Include="Shenora.Windows" />
    <InternalsVisibleTo Include="Sallyport.Client.Tests" />
  </ItemGroup>

  <!-- The page, built from web/ into wwwroot/ (gitignored) and embedded. WithCulture="false": a name like msg.fr.json
       would otherwise go to a satellite assembly, out of the bundle. -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" WithCulture="false" />
  </ItemGroup>

  <!-- WebView2's loader inside the program as well as beside it: setup, which is this program (D30), writes it beside
       the program it installs. Native, so a single file would otherwise unpack it to %TEMP% at every start. From the
       WebView2 package's assets as the build resolves them: per runtime without a runtime identifier, flat with one. -->
  <Target Name="CarryWebView2Loader" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolvePackageAssets">
    <ItemGroup>
      <_Loader Include="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'WebView2Loader.dll' And '%(RuntimeIdentifier)' == 'win-x64'" />
      <_Loader Include="@(NativeCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'WebView2Loader.dll'" />
      <EmbeddedResource Include="@(_Loader->Distinct())" LogicalName="WebView2Loader.dll" WithCulture="false" />
    </ItemGroup>
    <Error Condition="'@(_Loader)' == ''" Text="WebView2Loader.dll for win-x64 was not among the WebView2 package's assets." />
  </Target>

  <!-- A fresh clone has no wwwroot, and the glob above was evaluated before this ran: the files it builds are added here. -->
  <Target Name="BuildPage" BeforeTargets="BeforeBuild" Condition="!Exists('wwwroot\index.html')">
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="web" Condition="!Exists('web\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="web" />
    <ItemGroup>
      <EmbeddedResource Include="wwwroot\**" WithCulture="false" />
    </ItemGroup>
  </Target>

</Project>

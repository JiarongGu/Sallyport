<Project Sdk="Microsoft.NET.Sdk">

  <!-- The bridge: runs with the package's identity (through its execution alias) so it may manage the plug-in's VPN
       profile; carries the programs' packets between the plug-in and the OpenVPN tunnel; guards the direct path (D13). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Sallyport\Sallyport.csproj" />
  </ItemGroup>

</Project>

<Project>
  <!-- The library itself takes nothing beyond the base library (CLAUDE.md, rule 4). The client takes Shenora by a
       decision (D9), at a pinned release from nuget.org; the rest are the tests'. -->
  <ItemGroup>
    <PackageVersion Include="Shenora.Windows" Version="0.21.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
